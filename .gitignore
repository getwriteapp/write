# dependencies
node_modules/

# build output
app/dist/
# copied from the repo root by `npm run prebuild` so the licence notices ship
# inside the binary as well as living in the repo — one source, no drift
app/public/THIRD-PARTY-NOTICES.md
app/src-tauri/target/
app/src-tauri/gen/schemas/

# generated test artifacts (the .docx fixtures are rebuilt on every run)
app/tests/out/

# Playwright's own run artifacts (traces, screenshots, HTML report) — rebuilt
# by every `npm run test:e2e`, never something to diff or commit
app/test-results/
app/playwright-report/

# local tooling & logs
.claude/
*.log

# The internal record: the build diary, the session-to-session orientation
# file, the running punch list, and the full vision/competitive/decision
# document. All four are written for an audience of one and none of them are
# product documentation. The public record is README (what it is), DESIGN
# (why it is that way), ROADMAP (what's next), CHANGELOG (what changed).
SESSIONS.md
HANDOFF.md
buildnotes.md
PROJECT.md
ISSUES.md

# design exploration pages — working material from before the app existed,
# kept locally because they still show the reasoning, not shipped because
# they no longer describe the app
design-lab.html
design-lab-2.html
fonts-preview.html

# personal test documents at the repo root
/*.docx

# bug-report screenshots dropped at the repo root (Windows names them by
# timestamp — transient evidence for a session, not project assets)
/*.png

# raw design source files (logo originals, icon previews) — working material,
# not meant to publish. The generated deliverables (icons/, tray/) are
# tracked normally; only the sources and internal preview pages live here.
/assets/

# internal strategy notes — licensing, market, revenue. Not product docs;
# not meant to be public when the repo flips.
*.private.md

# the card generators write their intermediate HTML here
docs/media/.card*.html
