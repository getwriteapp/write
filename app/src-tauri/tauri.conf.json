{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "write",
  "version": "0.1.0",
  "identifier": "app.write.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "write",
        "width": 1040,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A quiet, beautiful word processor.",
    "longDescription": "write is a lightweight, beautiful word processor. Start from silence; go up into rich text. Six built-in rooms, focus mode, and clean .docx export.",
    "category": "Productivity",
    "copyright": "© 2026 write contributors. GPL-3.0-or-later.",
    "licenseFile": "../../LICENSE"
  }
}
