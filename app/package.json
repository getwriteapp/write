{
  "name": "write",
  "private": true,
  "version": "0.4.3",
  "description": "A quiet, beautiful word processor. Start from silence; go up into rich text.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').copyFileSync('../THIRD-PARTY-NOTICES.md','public/THIRD-PARTY-NOTICES.md')\"",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:docx": "node tests/roundtrip.mjs",
    "test:security": "node tests/sanitize-probe.mjs",
    "test:licenses": "node tests/license-check.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:docx && npm run test:security && npm run test:licenses && npm run test:unit && npm audit --audit-level=high",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
