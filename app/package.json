{
  "name": "write",
  "private": true,
  "version": "0.1.1",
  "description": "A quiet, beautiful word processor. Start from silence; go up into rich text.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').copyFileSync('../THIRD-PARTY-NOTICES.md','public/THIRD-PARTY-NOTICES.md')\"",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:docx": "node tests/roundtrip.mjs",
    "test:security": "node tests/sanitize-probe.mjs",
    "test": "npm run test:docx && npm run test:security && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tiptap/html": "^2.27.2",
    "svelte": "^5.28.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.2.8",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
